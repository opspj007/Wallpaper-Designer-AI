{
  "builds": [
    {
      "src": "store/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": "staticfiles/**",
        "maxLambdaSize": "50mb"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "store/wsgi.py"
    }
  ],
  "functions": {
    "store/wsgi.py": {
      "maxDuration": 60
    }
  }
}
